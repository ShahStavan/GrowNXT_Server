# ==============================================================================
# GrowNXT Server Configuration Environment Variables
# ==============================================================================

# LLM Provider selection: 'ollama' | 'gemini' | 'groq' | 'grownxt'
LLM_PROVIDER=ollama

# Ollama Configuration (Local inference)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini API Configuration (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Groq API Configuration (if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# GrowNXT Hosted Inference (if LLM_PROVIDER=grownxt)
GROWNXT_LLM_API_URL=https://grownxt-llm.vercel.app
GROWNXT_LLM_API_KEY=

# Financial Data Collector REST API (Default live service)
FINANCIAL_DATA_SERVICE_URL=https://financial-data-collector-qrxj.vercel.app

# Qdrant vector store (Track 2 RAG + Nifty 50 batch embeddings).
# Leave QDRANT_API_URL unset and the indexer falls back to an in-memory store
# that is lost when the process exits -- fine for a smoke test, useless for a
# batch run. Each stock gets its own collection: <QDRANT_COLLECTION_NAME>_<ticker>.
QDRANT_API_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=grownxt-embeddings
# QDRANT_COLLECTION_PER_TICKER=1        # 0 = one shared collection with a ticker filter
# QDRANT_COLLECTION_PREFIX=             # override the per-ticker prefix (default: collection name)

# Nifty 50 batch embedding job (scripts/embed_nifty50.py)
# GROWNXT_LOG_DIR=./logs                # where logs/nifty50/ is written
# NIFTY50_NOTIFY_WEBHOOK_URL=           # Slack/Discord/Teams incoming webhook, POSTed once per run
# NIFTY50_ADMIN_TOKEN=                  # bearer token for POST /api/embeddings/nifty50/run (unset = route disabled)

# Compute (core/hardware.py). All detected per machine; set only to override.
# Check what a run would resolve to: python -m scripts.embed_nifty50 --hardware
# GROWNXT_DEVICE=                       # auto|cuda|cuda:1|cpu|mps|xpu (default: auto-detect)
# GROWNXT_NUM_THREADS=                  # extraction threads (default: physical cores; Docling's own default is 4)
# GROWNXT_EMBED_BATCH_SIZE=             # texts per encode call (default: sized from VRAM)
# GROWNXT_EMBED_FP16=                   # 0 keeps the embedding model in float32 (default: on for CUDA)

# QDRANT API Configuration
QDRANT_API_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# NTFY Configuration -- no account needed. Pick a topic, subscribe to it in the
# ntfy app or at the same URL in a browser. One push per completed run; with
# NIFTY50_NOTIFY_EMAIL_TO set, ntfy forwards the same message to that inbox.
NIFTY50_NOTIFY_WEBHOOK_URL=
NIFTY50_NOTIFY_EMAIL_TO=