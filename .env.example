# ==============================================================================
# GrowNXT Server Configuration Environment Variables
# ==============================================================================

# LLM Provider selection: 'ollama' | 'gemini' | 'groq' | 'grownxt'
LLM_PROVIDER=ollama

# Ollama Configuration (Local inference)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini API Configuration (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Groq API Configuration (if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# GrowNXT Hosted Inference (if LLM_PROVIDER=grownxt)
GROWNXT_LLM_API_URL=https://grownxt-llm.vercel.app
GROWNXT_LLM_API_KEY=

# Financial Data Collector REST API (Default live service)
FINANCIAL_DATA_SERVICE_URL=https://financial-data-collector-qrxj.vercel.app
